# Environment variables (placeholders only - never commit real secrets).
# Copy to .env and fill in, or export them in your shell.

# --- PostgreSQL ---
DB_URL=jdbc:postgresql://localhost:5432/cabbooking
DB_USER=cabuser
DB_PASSWORD=cabpass
# DDL_AUTO: update = Hibernate creates tables for you (local dev).
#            validate = use database/schema.sql (production / Docker).
DDL_AUTO=update

# --- Security (MANDATORY: set a long random value in production) ---
JWT_SECRET=change-this-dev-secret-to-at-least-32-chars
CORS_ORIGINS=http://localhost:5173

# --- First admin account (created on startup when both are set) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-immediately

# --- Stripe test mode (OPTIONAL - app works without it) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Pricing (optional overrides, INR) ---
FARE_BASE=60
FARE_PER_KM=15
FARE_MIN=80
